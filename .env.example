# Optional: URL for PDF download (used by website build)
PDF_DOWNLOAD_URL=

# WrangleAI API key (used by extract-tradeoffs.js for AI extraction)
# Get yours at https://wrangleai.com
WRANGLE_API_KEY=

# ── MCP billing / auth (local + Vercel; never commit real values) ────────────
# Stripe (use sk_test_ / pk_test_ until production cutover)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_URL=

# Upstash Redis / Vercel KV (REST primary)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
# KV_URL / REDIS_URL are optional TCP URLs; unused in v1

# Auth + app
AUTH_SECRET=
APP_BASE_URL=https://www.agenticaf.io
MCP_AUTH_REQUIRED=false

# Resend (magic links). From must be on verified domain agenticaf.io
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@agenticaf.io
